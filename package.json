{
  "name": "git-account-manager",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.gitaccountmanager.app",
    "productName": "GitAccountManager",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Git Account Manager GUI",
  "dependencies": {
    "element-plus": "^2.13.1",
    "fs-extra": "^11.3.3",
    "simple-git": "^3.30.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "electron-packager": "^17.1.2",
    "vite": "^7.3.1",
    "wait-on": "^7.2.0"
  }
}
